# Copiar como .env.local para desarrollo, y cargar las mismas variables en Vercel.
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo en el servidor (nunca con prefijo NEXT_PUBLIC). Se usa para invitar usuarios.
SUPABASE_SERVICE_ROLE_KEY=
# Dirección pública de la app, sin barra final
NEXT_PUBLIC_SITE_URL=https://agricola-bas.vercel.app
